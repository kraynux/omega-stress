/* Profil `reduced` : palette reduite, UI simplifiee, moins d'ornements
 * (voir plan produit, "Profils de rendu"). Retour utilisateur : la
 * bordure/fond/padding de ".omega-panel" (cadre "application", voir
 * styles/terminal_frame.tcss) est desormais UNIFORME sur les 4 profils -
 * l'ancienne surcharge ici ("border: none", padding resserre) la
 * masquait silencieusement (chargee APRES terminal_frame.tcss), retiree
 * pour uniformiser avec les autres outils omega- (aucun ne surcharge
 * ces classes par profil). */

DataTable {
    border: none;
}

.omega-badge {
    background: $surface;
    color: $primary;
}
